{
    "name": "thebigcrafter/advancedpluginmanager",
    "description": "Plugin manager for PocketMine-MP",
    "type": "project",
    "require": {
        "php": "^8.0",
        "cortexpe/commando": "^3.0.0",
        "dktapps/pmforms": "^2.3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.3",
        "pocketmine/pocketmine-mp": "^5.44.3"
    },
    "license": "GPL-3.0-only",
    "autoload": {
        "psr-4": {
            "thebigcrafter\\APM\\": "src/"
        }
    },
    "scripts": {
        "fix-cs": "./vendor/bin/php-cs-fixer fix",
        "analyse": "./vendor/bin/phpstan analyse -c phpstan.neon.dist"
    },
    "authors": [
        {
            "name": "MintoD",
            "email": "tobythedev7@outlook.com",
            "homepage": "https://github.com/MintoD",
            "role": "Developer"
        },
        {
            "name": "Mcbeany",
            "homepage": "https://github.com/Mcbeany",
            "role": "Contributor"
        },
        {
            "name": "NhanAZ",
            "email": "nhanaz@pm.me",
            "homepage": "https://github.com/NhanAZ",
            "role": "Contributor"
        }
    ],
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "cortexpe/commando",
                "version": "3.0.0",
                "type": "library",
                "description": "A Command Framework virion for PocketMine-MP",
                "dist": {
                    "url": "https://api.github.com/repos/CortexPE/Commando/zipball/89a1bc1f9ffb748004888e38e0479e2ec58a3fc4",
                    "type": "zip"
                },
                "source": {
                    "type": "git",
                    "url": "https://github.com/CortexPE/Commando.git",
                    "reference": "89a1bc1f9ffb748004888e38e0479e2ec58a3fc4"
                },
                "autoload": {
                    "psr-4": {
                        "CortexPE\\Commando\\": "src/CortexPE/Commando/"
                    }
                },
                "extra": {
                    "virion": {
                        "spec": "3.0",
                        "namespace-root": "CortexPE\\Commando"
                    }
                },
                "license": [
                    "LGPL-3.0-only"
                ],
                "support": {
                    "source": "https://github.com/CortexPE/Commando/tree/PM4",
                    "issues": "https://github.com/CortexPE/Commando/issues"
                },
                "time": "2021-11-21T08:13:35+00:00"
            }
        },
        {
            "type": "package",
            "package": {
                "name": "dktapps/pmforms",
                "version": "2.3.0",
                "type": "library",
                "description": "Form API library for PocketMine-MP plugins",
                "dist": {
                    "url": "https://api.github.com/repos/dktapps-pm-pl/pmforms/zipball/70082f430c722b868dfdfeab7337ba6b944d21dd",
                    "type": "zip"
                },
                "source": {
                    "type": "git",
                    "url": "https://github.com/dktapps-pm-pl/pmforms.git",
                    "reference": "70082f430c722b868dfdfeab7337ba6b944d21dd"
                },
                "autoload": {
                    "psr-4": {
                        "dktapps\\pmforms\\": "src/dktapps/pmforms/"
                    }
                },
                "extra": {
                    "virion": {
                        "spec": "3.0",
                        "namespace-root": "dktapps\\pmforms"
                    }
                },
                "license": [
                    "LGPL-3.0"
                ],
                "support": {
                    "source": "https://github.com/dktapps-pm-pl/pmforms/tree/2.3.0",
                    "issues": "https://github.com/dktapps-pm-pl/pmforms/issues"
                },
                "time": "2025-03-27T17:10:08+00:00"
            }
        }
    ]
}
