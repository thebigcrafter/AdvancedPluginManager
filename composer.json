{
    "name": "thebigcrafter/advancedpluginmanager",
    "description": "Plugin manager for PocketMine-MP",
    "type": "project",
    "require": {
        "php": "^8.1",
        "thebigcrafter/commando": "3.3.1",
        "dktapps/pmforms": "2.3.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.3",
        "pocketmine/pocketmine-mp": "^5.44.3"
    },
    "license": "GPL-3.0-only",
    "autoload": {
        "psr-4": {
            "thebigcrafter\\APM\\": "src/"
        }
    },
    "scripts": {
        "fix-cs": "./vendor/bin/php-cs-fixer fix",
        "analyse": "./vendor/bin/phpstan analyse -c phpstan.neon.dist"
    },
    "authors": [
        {
            "name": "MintoD",
            "email": "tobythedev7@outlook.com",
            "homepage": "https://github.com/MintoD",
            "role": "Developer"
        },
        {
            "name": "Mcbeany",
            "homepage": "https://github.com/Mcbeany",
            "role": "Contributor"
        },
        {
            "name": "NhanAZ",
            "email": "nhanaz@pm.me",
            "homepage": "https://github.com/NhanAZ",
            "role": "Contributor"
        }
    ],
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "thebigcrafter/commando",
                "version": "3.3.1",
                "type": "library",
                "description": "A command framework virion for PocketMine-MP",
                "dist": {
                    "url": "https://github.com/thebigcrafter/Commando/archive/963f7c0162ac195f76bfec0cfc7810164e4007b4.zip",
                    "type": "zip"
                },
                "source": {
                    "type": "git",
                    "url": "https://github.com/thebigcrafter/Commando.git",
                    "reference": "963f7c0162ac195f76bfec0cfc7810164e4007b4"
                },
                "require": {
                    "php": "^8.1"
                },
                "autoload": {
                    "psr-4": {
                        "CortexPE\\Commando\\": "src/CortexPE/Commando/"
                    }
                },
                "extra": {
                    "virion": {
                        "spec": "3.1",
                        "namespace-root": "CortexPE\\Commando"
                    }
                },
                "license": [
                    "LGPL-3.0-only"
                ]
            }
        },
        {
            "type": "package",
            "package": {
                "name": "dktapps/pmforms",
                "version": "2.3.4",
                "type": "library",
                "description": "Form API library for PocketMine-MP plugins",
                "dist": {
                    "url": "https://github.com/thebigcrafter/pmforms/archive/51ebfa15d1b4449943c437066efed8a13bbcb543.zip",
                    "type": "zip"
                },
                "source": {
                    "type": "git",
                    "url": "https://github.com/thebigcrafter/pmforms.git",
                    "reference": "51ebfa15d1b4449943c437066efed8a13bbcb543"
                },
                "require": {
                    "php": "^8.1"
                },
                "autoload": {
                    "psr-4": {
                        "dktapps\\pmforms\\": "src/dktapps/pmforms/"
                    }
                },
                "extra": {
                    "virion": {
                        "spec": "3.0",
                        "namespace-root": "dktapps\\pmforms"
                    }
                },
                "license": [
                    "LGPL-3.0"
                ]
            }
        }
    ]
}
